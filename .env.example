APP_NAME="Amelia Boutique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Frontend Next.js -------------------------------------------------------
# Origen del catálogo público. Lo usa CORS y el enlace "Ver catálogo" del panel.
FRONTEND_URL=http://localhost:3000

# Tras cada cambio en el panel se hace POST aquí para que Next.js purgue su caché.
# NEXT_REVALIDATE_SECRET debe coincidir con REVALIDATE_SECRET del frontend.
# Déjalo vacío para desactivar el aviso.
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
NEXT_REVALIDATE_SECRET=

# --- Base de datos ----------------------------------------------------------
# PostgreSQL obligatorio: el esquema usa jsonb (columna prendas.tallas) y no es
# portable a sqlite ni a MySQL sin cambios.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=amelia_boutique
DB_USERNAME=amelia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción, con HTTPS:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# 'public' para que las fotos de las prendas queden en storage/app/public
# y se sirvan por /storage/** (requiere `php artisan storage:link`).
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 'log' escribe los correos en storage/logs en vez de enviarlos: con esto el
# enlace "¿Olvidaste tu contraseña?" no envía nada. Configura SMTP en producción.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@ameliaboutique.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
